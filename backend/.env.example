# Clean AI Backend Environment Configuration

# Service Settings
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="Clean AI — Public Toilet Cleanliness Platform"

# Trained AI Model Path (Auto-discovered if left blank)
CLEAN_AI_MODEL_PATH=""
MODEL_IMAGE_SIZE=320
CONFIDENCE_THRESHOLD=0.25

# MongoDB Configuration (Supports MongoDB Atlas or local MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="clean_ai_database"

# Security & Authentication
JWT_SECRET="clean-ai-production-super-secret-key-change-in-prod"
MAX_FILE_SIZE_MB=15
STALE_DAYS_THRESHOLD=3
